@page "/"
@inject StatePreferenceService StatePreferenceService
@inject HolidayFilterService HolidayFilterService
@inject SchoolHolidayFilterService SchoolHolidayFilterService
@inject SittingFilterService SittingFilterService

<PageTitle>Australian Holidays</PageTitle>

<div class="controls view-toggle">
    <button class="state-btn @(view == ViewMode.Public ? "selected" : "")" @onclick="() => SetView(ViewMode.Public)">Public Holidays</button>
    <button class="state-btn @(view == ViewMode.School ? "selected" : "")" @onclick="() => SetView(ViewMode.School)">School Holidays</button>
    <button class="state-btn @(view == ViewMode.Parliament ? "selected" : "")" @onclick="() => SetView(ViewMode.Parliament)">Parliament</button>
</div>

@* Sittings are federal, so the state picker has nothing to act on in that view. *@
@if (view != ViewMode.Parliament)
{
    <div class="controls">
        <StateSelector SelectedStates="selectedStates" SelectedStatesChanged="OnStatesChanged" />
    </div>
}

@if (view == ViewMode.Public)
{
    <div class="controls">
        <YearSelector Is12MonthsMode="is12MonthsMode" Is12MonthsModeChanged="OnIs12MonthsModeChanged"
                      SelectedYears="selectedYears" SelectedYearsChanged="OnSelectedYearsChanged" />
    </div>
    <div class="controls">
        <ExportMenu SelectedStates="selectedStates" StartYear="startYear" YearCount="yearCount" />
    </div>

    <HolidayList Holidays="holidays" ShowStateColumn="@(selectedStates.Count != 1)" />

    <HolidayLogicInfo />
}
else if (view == ViewMode.School)
{
    <div class="controls">
        <SchoolYearSelector AvailableYears="availableSchoolYears" SelectedYears="selectedSchoolYears" SelectedYearsChanged="OnSchoolYearsChanged" />
    </div>

    <SchoolHolidayList Holidays="schoolHolidays" SelectedStates="selectedStates" SelectedYears="selectedSchoolYears" />

    <SchoolHolidayInfo />
}
else
{
    <div class="controls">
        <ChamberSelector SelectedChambers="selectedChambers" SelectedChambersChanged="OnChambersChanged" />
    </div>
    <div class="controls">
        <SchoolYearSelector AvailableYears="availableSittingYears" SelectedYears="selectedSittingYears" SelectedYearsChanged="OnSittingYearsChanged" />
    </div>

    <SittingList Periods="sittings" Estimates="estimates" SelectedChambers="selectedChambers" SelectedYears="selectedSittingYears" />

    <SittingInfo />
}

@code {
    enum ViewMode
    {
        Public,
        School,
        Parliament
    }

    ViewMode view = ViewMode.Public;
    HashSet<State> selectedStates = [.. Enum.GetValues<State>()];

    IReadOnlyList<HolidayViewModel>? holidays;
    Date startDate;
    Date endDate;
    int startYear;
    int yearCount;
    bool is12MonthsMode = true;
    HashSet<int> selectedYears = [];

    IReadOnlyList<int> availableSchoolYears = [];
    HashSet<int> selectedSchoolYears = [];
    IReadOnlyList<SchoolHolidayViewModel>? schoolHolidays;

    HashSet<Chamber> selectedChambers = [.. Enum.GetValues<Chamber>()];
    IReadOnlyList<int> availableSittingYears = [];
    HashSet<int> selectedSittingYears = [];
    IReadOnlyList<SittingViewModel>? sittings;
    IReadOnlyList<SittingViewModel>? estimates;

    protected override async Task OnInitializedAsync()
    {
        UpdateDateRange();

        var savedState = await StatePreferenceService.GetSavedStateAsync();

        if (savedState.HasValue)
        {
            selectedStates = [savedState.Value];
        }

        LoadHolidays();
        RefreshSchoolYears();
        LoadSchoolHolidays();
        RefreshSittingYears();
        LoadSittings();
    }

    void SetView(ViewMode mode) => view = mode;

    async Task OnStatesChanged(IReadOnlySet<State> states)
    {
        selectedStates = new(states);

        if (states.Count == 1)
        {
            await StatePreferenceService.SaveStateAsync(states.First());
        }
        else
        {
            await StatePreferenceService.SaveStateAsync(null);
        }

        LoadHolidays();
        RefreshSchoolYears();
        LoadSchoolHolidays();
    }

    Task OnIs12MonthsModeChanged(bool value)
    {
        is12MonthsMode = value;
        UpdateDateRange();
        LoadHolidays();
        return Task.CompletedTask;
    }

    Task OnSelectedYearsChanged(IReadOnlySet<int> years)
    {
        selectedYears = new(years);
        UpdateDateRange();
        LoadHolidays();
        return Task.CompletedTask;
    }

    Task OnSchoolYearsChanged(IReadOnlySet<int> years)
    {
        selectedSchoolYears = new(years);
        LoadSchoolHolidays();
        return Task.CompletedTask;
    }

    Task OnChambersChanged(IReadOnlySet<Chamber> chambers)
    {
        selectedChambers = new(chambers);
        RefreshSittingYears();
        LoadSittings();
        return Task.CompletedTask;
    }

    Task OnSittingYearsChanged(IReadOnlySet<int> years)
    {
        selectedSittingYears = new(years);
        LoadSittings();
        return Task.CompletedTask;
    }

    void UpdateDateRange()
    {
        if (is12MonthsMode)
        {
            (startDate, endDate) = HolidayFilterService.GetDefaultDateRange();
        }
        else if (selectedYears.Count > 0)
        {
            var minYear = selectedYears.Min();
            var maxYear = selectedYears.Max();
            startDate = new(minYear, 1, 1);
            endDate = new(maxYear, 12, 31);
        }

        (startYear, yearCount) = HolidayFilterService.GetExportYearRange(startDate, endDate);
    }

    void LoadHolidays()
    {
        holidays = HolidayFilterService.GetHolidays(selectedStates, startDate, endDate);
    }

    // Keep the school year options in sync with the selected states (coverage differs per state) and
    // keep at least the default year selected so the view is not empty.
    void RefreshSchoolYears()
    {
        availableSchoolYears = SchoolHolidayFilterService.GetAvailableYears(selectedStates);
        selectedSchoolYears = [.. selectedSchoolYears.Where(availableSchoolYears.Contains)];

        if (selectedSchoolYears.Count == 0)
        {
            var defaultYear = SchoolHolidayFilterService.GetDefaultYear(selectedStates);
            if (defaultYear.HasValue)
            {
                selectedSchoolYears = [defaultYear.Value];
            }
        }
    }

    void LoadSchoolHolidays()
    {
        schoolHolidays = SchoolHolidayFilterService.GetHolidays(selectedStates, selectedSchoolYears);
    }

    // Same shape as RefreshSchoolYears: keep the year options in sync with the selected chambers and
    // keep at least the default year selected so the view is not empty.
    void RefreshSittingYears()
    {
        availableSittingYears = SittingFilterService.GetAvailableYears(selectedChambers);
        selectedSittingYears = [.. selectedSittingYears.Where(availableSittingYears.Contains)];

        if (selectedSittingYears.Count == 0)
        {
            var defaultYear = SittingFilterService.GetDefaultYear(selectedChambers);
            if (defaultYear.HasValue)
            {
                selectedSittingYears = [defaultYear.Value];
            }
        }
    }

    void LoadSittings()
    {
        sittings = SittingFilterService.GetPeriods(selectedChambers, selectedSittingYears);
        estimates = SittingFilterService.GetEstimates(selectedSittingYears);
    }
}
